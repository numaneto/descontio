# --- Telegram (user-client, via Telethon) ---
# Gere em https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Gerada por scripts/telegram_login.py — NUNCA comite, equivale a uma senha
TELEGRAM_SESSION_STRING=

# --- Banco de dados ---
DATABASE_URL=sqlite:///./data/descontio.db

# --- Mídia (fotos baixadas dos posts) ---
MEDIA_DIR=./media
IMAGE_MAX_WIDTH=800
IMAGE_QUALITY=80

# Após N dias, a oferta é arquivada (some da busca padrão do portal) e a
# imagem física é apagada do disco -- o texto/metadados nunca são apagados.
RETENTION_DAYS=7

# --- Offer Formatter (endpoint OpenAI-compatible) ---
# Com LLM_ENABLED=true, todo candidato aprovado pelo pré-filtro local passa
# pelo modelo. Use uma API key dedicada por instalação/projeto.
LLM_ENABLED=false
LLM_BASE_URL=https://routellm.abacus.ai/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3.8-Flash-Next
# Preços do modelo contratado, usados só para calcular e registrar o custo.
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0

# --- Administração (/admin/*, HTTP Basic) ---
# Sem ambos os valores, as rotas administrativas retornam 503.
ADMIN_USER=
ADMIN_PASSWORD=

# --- Portal ---
APP_HOST=0.0.0.0
APP_PORT=8000
